# ============================================================================
# mysticbbsirc .gitignore — post-VIPER layout
# ============================================================================

# Free Pascal compiler artifacts
*.ppu
*.o
*.a
*.or
*.s
*.compiled
*.mpx
link.res
link*.res
ppas.sh

# Compiled binaries in source dirs (built from source, not distributed)
mystic_test/mystic
mystic_test/mis
mystic_test/mkcrap
mystic_test/mktheme2
mystic_test/mksec
mystic_test/mkuser
mystic_test/makemenu
mystic_test/maketext
mystic_test/rendermrp
mystic_mterm/mterm
mystic_ripview/source/ripview
mystic_ansiedit/ansiedit

# BUT keep distributed release binaries
!mystic/mystic
!mystic/mis
!mystic_ripview/linux/ripview

# Runtime/temp files
mterm_screen.bin
CLEANUP.LOG
VIPER-VERIFY.LOG
*.bsy

# Build output directories
out/
outwin/
out386/
out_darwin/
bin/
release/
mystic-*.zip
out-*/
mystic_*/out/
mystic_*/bin/
mystic_*/out64/
mystic_*/bin64/
mystic_*/outwin/
mystic_*/binwin/

# Temp/runtime dirs (contents, not dirs themselves)
mystic_test/temp/*
mystic_test/temp0/*
mystic_test/temp1/*
mystic_test/logs/*
mystic_test/semaphore/*

# Editor / OS cruft
*.bak
*.orig
*~
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc

# Add-on module generated files
modem.ini
mystic_modem/out/
mystic_modem/bin/
mystic_mailer/out/
mystic_mailer/bin/

# Keep third-party and distributed binaries
!thirdparty/**/*.exe
!thirdparty/**/*.EXE
!utilities/**/*.exe
!utilities/**/*.EXE
!libs/**/*.dll
!libs/**/*.so
!libs/**/*.so.*
!libs/**/*.dylib
!libs/*.dll
!libs/*.so
!libs/*.so.*
!libs/*.dylib

# Keep Darwin ld64 cross-toolchain
!libs/ld64-linux-x86_64/
!libs/ld64-linux-x86_64/bin/
!libs/ld64-linux-x86_64/bin/*
!libs/ld64-linux-x86_64/lib/
!libs/ld64-linux-x86_64/lib/*
